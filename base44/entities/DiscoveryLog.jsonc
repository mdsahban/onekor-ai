{
  "name": "DiscoveryLog",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Reference to DiscoveryRun"
    },
    "source_id": {
      "type": "string",
      "description": "Reference to DiscoverySource"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "error",
        "debug"
      ],
      "default": "info"
    },
    "stage": {
      "type": "string",
      "enum": [
        "connect",
        "authenticate",
        "fetch",
        "normalize",
        "classify",
        "deduplicate",
        "correlate",
        "enrich",
        "upsert"
      ],
      "default": "connect"
    },
    "message": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number"
    },
    "details": {
      "type": "object",
      "description": "Technical details shown in an expandable section"
    }
  },
  "required": [
    "run_id",
    "source_id",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}