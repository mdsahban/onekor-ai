{
  "name": "AiAssetSource",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "description": "Reference to AiAsset"
    },
    "source_id": {
      "type": "string",
      "description": "Reference to DiscoverySource"
    },
    "external_id": {
      "type": "string",
      "description": "Connector-specific external ID for deduplication"
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "asset_id",
    "source_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}